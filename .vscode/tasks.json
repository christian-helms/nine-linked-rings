{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Teleoperate",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "source ${workspaceFolder}/nine-linked-rings-venv/bin/activate && python ${workspaceFolder}/teleoperation/teleop_in_vr.py --anim_recording_enabled --anim_recording_start_time 1 --anim_recording_stop_time 180"
            ],
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Teleoperate Gripper",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "source ${workspaceFolder}/.env && source ${workspaceFolder}/nine-linked-rings-venv/bin/activate && python ${workspaceFolder}/teleoperation/teleop_gripper.py"
            ],
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Gripper Env W/O Teleop",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "source ${workspaceFolder}/.env && source ${workspaceFolder}/nine-linked-rings-venv/bin/activate && python ${workspaceFolder}/environments/gripper_env_cfg.py"
            ],
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Env W/O Teleop",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "source ${workspaceFolder}/nine-linked-rings-venv/bin/activate && python ${workspaceFolder}/environments/pretty_env_cfg.py"
            ],
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "IsaacSim",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "source ${workspaceFolder}/.env && source ${workspaceFolder}/nine-linked-rings-venv/bin/activate && ./_isaac_sim/isaac-sim.sh --xr"
            ],
            "problemMatcher": []
        },
        {
            "label": "Collect Manus Mocap Data",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "source ${workspaceFolder}/GeoRT/geort/mocap/geort-mocap/bin/activate && python ${workspaceFolder}/GeoRT/collect_manus_mocap_data.py"
            ],
        },
        {
            "label": "Train GeoRT",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "source ${workspaceFolder}/nine-linked-rings-venv/bin/activate && cd ${workspaceFolder}/GeoRT/ && python geort/trainer.py -hand allegro_right -human_data my_right_hand -ckpt_tag my_right_hand_0"
            ],
            "problemMatcher": []
        },
        {
            "label": "Manus Mocap Evaluation",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "source ${workspaceFolder}/nine-linked-rings-venv/bin/activate && cd ${workspaceFolder}/GeoRT/ && python geort/mocap/manus_evaluation.py -hand allegro_right -ckpt_tag my_right_hand_0"
            ],
            "problemMatcher": []
        }
        {
            "label": "setup_python_env",
            "type": "shell",
            "linux": {
                "command": "${workspaceFolder}/isaaclab.sh -p ${workspaceFolder}/.vscode/tools/setup_vscode.py"
            },
            "windows": {
                "command": "${workspaceFolder}/isaaclab.bat -p ${workspaceFolder}/.vscode/tools/setup_vscode.py"
            }
        },
        {
            "label": "run_formatter",
            "type": "shell",
            "linux": {
                "command": "${workspaceFolder}/isaaclab.sh --format"
            },
            "windows": {
                "command": "${workspaceFolder}/isaaclab.bat --format"
            }
        }
    ]
}